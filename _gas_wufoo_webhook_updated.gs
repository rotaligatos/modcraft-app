// Checks the file-field list against a real submission without touching Drive,
// Sheets or Supabase. Paste an EntryId from the Wufoo Debug tab: it reports how
// many files that submission carried and which fields they were in, so a form
// change that adds a twelfth field shows up here rather than as a quiet loss.
function testFileFields(entryId) {
  var ss = SpreadsheetApp.openById(SHEETS_ID);
  var dbg = ss.getSheetByName(DEBUG_SHEET);
  if (!dbg) { Logger.log('No debug sheet yet.'); return; }
  var rows = dbg.getDataRange().getValues();
  for (var r = rows.length - 1; r > 0; r--) {
    var raw;
    try { raw = JSON.parse(rows[r][1]); } catch(e) { continue; }
    if (entryId && String(raw['EntryId']) !== String(entryId)) continue;
    var known = [], unknown = [];
    for (var k in raw) {
      if (k.slice(-4) !== '-url' || !raw[k]) continue;
      var base = k.slice(0, -4);
      (FILE_FIELDS.indexOf(base) >= 0 ? known : unknown).push(base);
    }
    Logger.log('Entry ' + raw['EntryId'] + ': ' + known.length + ' file(s) captured — ' + known.join(', '));
    if (unknown.length) {
      Logger.log('!! ' + unknown.length + ' file field(s) NOT in FILE_FIELDS and would be dropped: ' + unknown.join(', '));
    }
    return;
  }
  Logger.log('No matching submission found in the debug sheet.');
}
