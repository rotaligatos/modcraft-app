#!/bin/sh
# Refuse a commit that introduces a silent collision.
#
# JavaScript lets a later definition quietly win, and getElementById quietly
# returns the first match — neither raises anything, so only a check finds it.
# See tools/check-collisions.mjs for the bugs that prompted this.
#
# Checks the STAGED content, not the working tree, so a fix you have not yet
# staged cannot mask a problem you are about to commit.
#
# Bypass in an emergency with:  git commit --no-verify

set -e

# Nothing to do if no HTML is staged.
staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.html$' || true)
[ -z "$staged" ] && exit 0

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found — skipping the collision check." >&2
  exit 0
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

files=""
for f in $staged; do
  out="$tmp/$(echo "$f" | tr '/' '_')"
  git show ":$f" > "$out"
  files="$files $out"
done

# shellcheck disable=SC2086
if ! node "$(git rev-parse --show-toplevel)/tools/check-collisions.mjs" $files; then
  echo ""
  echo "Commit stopped: the staged HTML has a collision (see above)."
  echo "None of these raise an error in the browser, which is why this check exists."
  echo "If you are certain, bypass with:  git commit --no-verify"
  exit 1
fi
